# systemd USER unit for vaultd (password exchange with the Agent app Vault tab).
# Not installed by the repo. Install (after Joe's go, spec section 17):
#   go build -o ~/.local/bin/vaultd ./cmd/vaultd
#   cp deploy/vaultd.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#   systemctl --user enable --now vaultd
[Unit]
Description=vaultd (Vault tab password exchange, /vault/v1/*)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/vaultd serve -config %h/.config/vaultd/config.json
WorkingDirectory=%h
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
